# Copy to .env before starting. Use random values for every password and key.
# Keep database, RabbitMQ, MinIO, and JWT secrets to alphanumeric characters
# so connection URLs do not need URL encoding.

APP_PORT=8080

MYSQL_DATABASE=lottery
MYSQL_USER=lottery
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_HEX
MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_HEX
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX

RABBITMQ_USER=lottery
RABBITMQ_PASSWORD=REPLACE_WITH_RANDOM_HEX
RABBITMQ_VHOST=lottery

MINIO_ACCESS_KEY=lottery
MINIO_SECRET_KEY=REPLACE_WITH_RANDOM_HEX
MINIO_BUCKET=lottery
# For remote access replace localhost with the public domain and scheme.
MINIO_PUBLIC_URL=http://localhost:8080/storage

# Must contain at least 32 characters. Generate a unique random value.
JWT_SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD
ADMIN_PHONE=13900000000
